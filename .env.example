# Copy: cp .env.example .env  (— .env is never committed, see .gitignore)

# Local development (no Docker/Postgres) — default:
DATABASE_URL=sqlite:///./fraud.db

# When using PostgreSQL via docker-compose (docker-compose up -d db):
# POSTGRES_DB=fraud_detection
# POSTGRES_USER=fraud_user
# POSTGRES_PASSWORD=fraud_pass
# DATABASE_URL=postgresql+psycopg2://fraud_user:fraud_pass@localhost:5432/fraud_detection

MODEL_DIR=models
XGB_MODEL_PATH=models/xgb_v1.pkl
CALIBRATOR_PATH=models/xgb_v1_calibrated.pkl
MODEL_VERSION=xgb_v1_calibrated

# LLM report generation. Leave LLM_API_KEY blank to always use the
# deterministic fallback report (no external calls, no key required).
# LLM_PROVIDER selects the branch in backend/llm_service.py — only "groq"
# is implemented; anything else always falls back.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
